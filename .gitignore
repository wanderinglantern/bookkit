# client contacts and premium figures live in the DB — never commit it
*.db
*.db-*
*.sqlite*
.venv/
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/
dist/
*.egg-info/
# dead: the write-only artifacts F14 replaced. Nothing writes here any more;
# the baselines the snapshot suite actually compares against are the tracked
# ones in tests/__snapshots__/. This pattern carried its comment inline until
# now, and git has no inline comments — so it matched nothing and the stale
# artifacts showed up as untracked in every status. Comments go on their own line.
tests/snapshots/
wheelhouse/
bookkit-wheelhouse-macos.zip
.install-pypi.log

# worktrees for isolated feature work — never part of a commit
.claude/worktrees/

# subagent-driven-development scratch (ledger, briefs, review packages)
.superpowers/

# browser-automation output from verification runs — regenerates, never reviewed
.playwright-mcp/
