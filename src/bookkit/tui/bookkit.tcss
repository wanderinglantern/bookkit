/* bookkit — shared TCSS. Keyboard-first, dense. Palette lives in theme.py;
   this file only references theme variables so the two never drift. */

Screen {
    background: $background;
}

/* slim scrollbars everywhere — chrome should whisper */
* {
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 1;
}

.pane {
    border: round $panel-lighten-2;
    padding: 0 1;
    height: 1fr;
}

.pane > .pane-title {
    color: $text-muted;
    text-style: bold;
}

#today-grid {
    layout: grid;
    grid-size: 2 2;
    grid-gutter: 0 1;
    height: 1fr;
}

DataTable {
    height: 1fr;
    background: transparent;
}

DataTable > .datatable--header {
    background: transparent;
    color: $text-muted;
    text-style: bold;
}

DataTable > .datatable--even-row {
    background: $surface-lighten-1 30%;
}

Tree {
    background: transparent;
}

Tree > .tree--guides {
    color: $panel-lighten-1;
}

Tree > .tree--guides-hover, Tree > .tree--guides-selected {
    color: $primary-darken-1;
}

Footer {
    background: $panel;
}

/* --- navigator (home) ------------------------------------------------------- */

#status-bar {
    height: 1;
    padding: 0 2;
    background: $panel;
    color: $text-muted;
}

#nav-split {
    height: 1fr;
}

#nav-tree {
    width: 44;
    min-width: 36;
    border-right: solid $panel-lighten-1;
    padding: 0 1;
}

#nav-pane {
    width: 1fr;
    padding: 0 1;
}

#nav-card {
    height: auto;
    padding: 1 2;
}

#table-hint {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

#nav-preview {
    height: 40%;
    border-top: solid $panel-lighten-1;
    overflow-x: auto;
    overflow-y: auto;
}

/* --- account screen ------------------------------------------------------- */

#account-header {
    height: auto;
    padding: 0 1;
    background: $panel;
    border-bottom: solid $panel-lighten-1;
}

#account-header .header-name {
    text-style: bold;
}

TabbedContent {
    height: 1fr;
}

#tower-preview {
    border: round $panel-lighten-2;
    padding: 0 1;
    height: 1fr;
    width: 1fr;
    overflow-x: auto;
    overflow-y: auto;
}

/* the preview's wide ANSI content must never starve the side panel */
#placement-side {
    height: 1fr;
    width: 44%;
    min-width: 44;
}

#placement-side #sync-state {
    height: auto;
    padding: 0 1;
}

/* --- modals ---------------------------------------------------------------- */

QuickCapture, SearchModal, ConfirmTask, LinkReview, PasteImportModal,
ImportChooser, ImportScreen, FormModal, Picker, ConfirmRenew, MergePicker {
    align: center middle;
}

#paste-preview, #import-preview {
    border: round $panel-lighten-2;
    padding: 0 1;
    height: auto;
    max-height: 16;
    overflow-y: auto;
}

.modal-box {
    width: 70%;
    max-width: 100;
    max-height: 80%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

.modal-box .modal-title {
    text-style: bold;
    color: $primary;
}

.field-label {
    color: $text-muted;
    margin-top: 1;
}

/* long pick-lists must never dominate a modal */
.modal-box OptionList {
    max-height: 10;
    border: round $panel-lighten-2;
}

.modal-box TextArea {
    height: 6;
}

.hint {
    color: $text-muted;
    margin-top: 1;
}

/* --- renewal calendar ------------------------------------------------------ */

#calendar-scroll {
    height: 1fr;
    overflow-x: auto;
    overflow-y: auto;
}

/* --- kanban ---------------------------------------------------------------- */

#kanban {
    layout: horizontal;
    height: 1fr;
}

.kanban-column {
    width: 1fr;
    border: round $panel-lighten-2;
    margin: 0 1 0 0;
    padding: 0 1;
}

.kanban-column .column-title {
    text-style: bold;
    color: $text-muted;
}

.kanban-column OptionList {
    height: 1fr;
    border: none;
}

.kanban-column.focused-column {
    border: round $primary;
}

/* --- onboarding wizard ------------------------------------------------------ */

#onboard-split {
    height: 1fr;
}

#onboard-steps {
    width: 38;
}

#onboard-pane {
    padding: 1 2;
}
